# Add to the `mcp-servers` stack .env in Dockge. Never commit real values.
# One random token per agent, e.g.:  openssl rand -hex 32
# The same token goes into that agent's MCPHub upstream entry as
#   Authorization: Bearer <token>

OBSIDIAN_MCP_TOKEN_CLAUDE=
OBSIDIAN_MCP_TOKEN_HERMES=
# Optional; leave empty to keep the `pi` identity disabled.
OBSIDIAN_MCP_TOKEN_PI=

# Optional: enable delete_file (moves notes to the vault's .trash/).
# OBSIDIAN_MCP_ENABLE_DELETE=1
